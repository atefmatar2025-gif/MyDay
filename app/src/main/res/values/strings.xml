    <!-- Permissions -->
    <string name="perm_all_good">كل شيء جاهز: ستصلك المنبّهات في وقتها.</string>
    <string name="perm_needs_attention">بعض الإعدادات قد تؤخر المنبّهات أو تمنعها. راجع البنود أدناه.</string>
    <string name="perm_notifications">الإشعارات</string>
    <string name="perm_notifications_desc">لازمة لعرض التذكيرات والمنبّه. بدونها لن يظهر أي تنبيه.</string>
    <string name="perm_exact">المنبّهات الدقيقة</string>
    <string name="perm_exact_desc">تجعل المنبّه يرنّ في الدقيقة المحددة حتى في وضع توفير الطاقة. إن رفضتها يستخدم التطبيق منبّهاً تقريبياً قد يتأخر عدة دقائق (أو أكثر عند سكون الجهاز الطويل)، ويظهر التنبيه كإشعار بدل الرنين.</string>
    <string name="perm_fullscreen">شاشة المنبّه الكاملة</string>
    <string name="perm_fullscreen_desc">تسمح بعرض شاشة المنبّه فوق شاشة القفل. بدونها يظهر المنبّه كإشعار بارز مع الصوت.</string>
    <string name="perm_channel">قناة المنبّهات</string>
    <string name="perm_channel_desc">إن عطّلت قناة «منبّهات المهام» من إعدادات النظام فلن تظهر شاشة المنبّه.</string>
    <string name="perm_battery">تحسين البطارية (اختياري)</string>
    <string name="perm_battery_desc">بعض الشركات المصنّعة تُغلق التطبيقات بقسوة. إن تأخرت التنبيهات على جهازك، استثنِ DAYFLOW من تحسين البطارية.</string>
    <string name="perm_how_alarms_work">كيف تعمل التنبيهات: كل تنبيه يُسجَّل في AlarmManager بموعده الدقيق، ويُعاد تسجيله تلقائياً بعد إعادة تشغيل الهاتف أو تغيير الساعة أو المنطقة الزمنية، ومرة كل 6 ساعات كإجراء احتياطي. عند الرنين تُشغَّل خدمة قصيرة تعمل فقط أثناء الرنين.</string>
